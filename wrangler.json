{
	"$schema": "node_modules/typeflare/schema.json",
	"name": "better-stack",
	"compatibility_date": "2025-05-05",
	"compatibility_flags": ["nodejs_compat"],
	"minify": true,
	"main": "./server/index.ts",
	"observability": {
		"enabled": true
	},
	"vars": {
		"NODE_ENV": "production",
		"BUN_VERSION": "1.2.15"
	},
	"env": {
		"development": {
			"vars": {
				"DEV": 1
			}
		}
	},
	"assets": {
		"directory": "out",
		"binding": "ASSETS",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page",
		"run_worker_first": ["/api/*"]
	},
	"send_metrics": false,
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "better-stack"
		}
	],
	"d1_databases": [
		{
			"binding": "DATABASE",
			"database_name": "better-stack",
			"database_id": "<ID>",
			"migrations_dir": "drizzle",
			"preview_database_id": "<ID>",
			"remote": true
		}
	],
	"typeflare": {
		"assets": {
			"ASSETS": null
		},
		"r2_buckets": {
			"BUCKET": true
		},
		"d1_databases": {
			"DATABASE": true
		}
	}
}
